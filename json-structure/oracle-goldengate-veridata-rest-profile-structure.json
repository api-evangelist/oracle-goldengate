{
  "$schema": "https://json-structure.org/draft/2020-12/schema",
  "name": "Profile",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "comparisonMethod": {
      "type": "string"
    },
    "maxConcurrentComparePairs": {
      "type": "integer"
    },
    "deltaProcessing": {
      "type": "boolean"
    },
    "reportOutOfSync": {
      "type": "boolean"
    }
  }
}