{
  "$schema": "https://json-structure.org/draft/2020-12/schema",
  "name": "ProcessMetrics",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "lag": {
      "type": "number"
    },
    "checkpointLag": {
      "type": "number"
    },
    "inputBytes": {
      "type": "integer"
    },
    "outputBytes": {
      "type": "integer"
    },
    "operationsProcessed": {
      "type": "integer"
    }
  }
}