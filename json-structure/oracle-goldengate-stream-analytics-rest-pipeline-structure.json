{
  "$schema": "https://json-structure.org/draft/2020-12/schema",
  "name": "Pipeline",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "createdBy": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "sources": {
      "type": "array"
    },
    "targets": {
      "type": "array"
    },
    "stages": {
      "type": "array"
    }
  }
}