        {
          "info": {
            "name": "Oracle Goldengate Retrieve Connection Metadata",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{veridata-host}:{port}/veridata/v1/services/configuration/connections/:Id/metadata",
