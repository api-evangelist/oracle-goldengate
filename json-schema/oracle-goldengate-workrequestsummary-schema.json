{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/WorkRequestSummary",
  "title": "WorkRequestSummary",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "abc123"
    },
    "operationType": {
      "type": "string",
      "example": "example_value"
    },
    "status": {
      "type": "string",
      "example": "example_value"
    },
    "percentComplete": {
      "type": "number",
      "example": 42.5
    },
    "timeAccepted": {
      "type": "string",
      "format": "date-time",
      "example": "2026-01-15T10:30:00Z"
    }
  }
}