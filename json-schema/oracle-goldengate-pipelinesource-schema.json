{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PipelineSource",
  "title": "PipelineSource",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "abc123"
    },
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "type": {
      "type": "string",
      "description": "Source type",
      "enum": [
        "Kafka",
        "GoldenGate",
        "JMS",
        "REST",
        "CSV",
        "Database"
      ],
      "example": "Kafka"
    },
    "connectionName": {
      "type": "string",
      "example": "example_value"
    }
  }
}