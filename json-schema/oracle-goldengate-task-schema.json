{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Task",
  "title": "Task",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "example": "active"
    },
    "description": {
      "type": "string",
      "example": "A sample description."
    },
    "schedule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "once",
            "recurring"
          ]
        },
        "interval": {
          "type": "string"
        },
        "startTime": {
          "type": "string",
          "format": "date-time"
        }
      },
      "example": "example_value"
    },
    "action": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "example": "example_value"
    }
  }
}