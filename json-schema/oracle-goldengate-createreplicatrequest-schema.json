    },
    "trail": {
      "type": "string",
      "example": "example_value"
    },
    "begin": {
      "type": "string",
      "example": "example_value"
    },
    "config": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "example": []
    },
    "checkpointTable": {
      "type": "string",
      "example": "example_value"
    }
  }
}