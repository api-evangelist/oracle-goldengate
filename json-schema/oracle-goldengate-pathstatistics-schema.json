{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PathStatistics",
  "title": "PathStatistics",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "bytesProcessed": {
      "type": "integer",
      "format": "int64",
      "example": 10
    },
    "messagesProcessed": {
      "type": "integer",
      "format": "int64",
      "example": 10
    },
    "lag": {
      "type": "string",
      "example": "example_value"
    }
  }
}