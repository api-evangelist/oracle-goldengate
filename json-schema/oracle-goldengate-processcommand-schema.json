{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ProcessCommand",
  "title": "ProcessCommand",
  "type": "object",
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "start",
        "stop",
        "kill",
        "forcestop",
        "status",
        "stats"
      ],
      "example": "start"
    }
  }
}