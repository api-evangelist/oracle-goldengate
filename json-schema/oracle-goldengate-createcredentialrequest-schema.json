{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/CreateCredentialRequest",
  "title": "CreateCredentialRequest",
  "type": "object",
  "required": [
    "userid",
    "password"
  ],
  "properties": {
    "userid": {
      "type": "string",
      "example": "500123"
    },
    "password": {
      "type": "string",
      "format": "password",
      "example": "example_value"
    }
  }
}