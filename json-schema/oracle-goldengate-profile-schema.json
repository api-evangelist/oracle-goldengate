{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Profile",
  "title": "Profile",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64",
      "example": "abc123"
    },
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "description": {
      "type": "string",
      "example": "A sample description."
    },
    "comparisonMethod": {
      "type": "string",
      "enum": [
        "row",
        "hash"
      ],
      "example": "row"
    },
    "maxConcurrentComparePairs": {
      "type": "integer",
      "example": 10
    },
    "deltaProcessing": {
      "type": "boolean",
      "example": true
    },
    "reportOutOfSync": {
      "type": "boolean",
      "example": true
    }
  }
}