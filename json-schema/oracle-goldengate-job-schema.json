{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Job",
  "title": "Job",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64",
      "example": "abc123"
    },
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "description": {
      "type": "string",
      "example": "A sample description."
    },
    "groupIds": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "int64"
      },
      "example": []
    },
    "profileId": {
      "type": "integer",
      "format": "int64",
      "example": "500123"
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "completed",
        "failed"
      ],
      "example": "idle"
    }
  }
}