{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ConnectionSummary",
  "title": "ConnectionSummary",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "abc123"
    },
    "displayName": {
      "type": "string",
      "example": "example_value"
    },
    "connectionType": {
      "type": "string",
      "example": "example_value"
    },
    "lifecycleState": {
      "type": "string",
      "example": "example_value"
    },
    "timeCreated": {
      "type": "string",
      "format": "date-time",
      "example": "2026-01-15T10:30:00Z"
    }
  }
}