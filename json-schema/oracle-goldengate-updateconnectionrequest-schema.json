{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/UpdateConnectionRequest",
  "title": "UpdateConnectionRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "description": {
      "type": "string",
      "example": "A sample description."
    },
    "host": {
      "type": "string",
      "example": "example_value"
    },
    "port": {
      "type": "integer",
      "example": 10
    },
    "username": {
      "type": "string",
      "example": "example_value"
    },
    "password": {
      "type": "string",
      "format": "password",
      "example": "example_value"
    }
  }
}