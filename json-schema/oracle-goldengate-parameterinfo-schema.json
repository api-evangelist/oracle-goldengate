{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ParameterInfo",
  "title": "ParameterInfo",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "example": "Example Title"
    },
    "description": {
      "type": "string",
      "example": "A sample description."
    },
    "type": {
      "type": "string",
      "example": "example_value"
    },
    "defaultValue": {
      "type": "string",
      "example": "example_value"
    },
    "validValues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "example": []
    }
  }
}