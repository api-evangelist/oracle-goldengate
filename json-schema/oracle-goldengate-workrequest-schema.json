{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/WorkRequest",
  "title": "WorkRequest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "example": "abc123"
    },
    "operationType": {
      "type": "string",
      "example": "example_value"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "IN_PROGRESS",
        "FAILED",
        "SUCCEEDED",
        "CANCELING",
        "CANCELED"
      ],
      "example": "ACCEPTED"
    },
    "percentComplete": {
      "type": "number",
      "example": 42.5
    },
    "timeAccepted": {
      "type": "string",
      "format": "date-time",
      "example": "2026-01-15T10:30:00Z"
    },
    "timeStarted": {
      "type": "string",
      "format": "date-time",
      "example": "2026-01-15T10:30:00Z"
    },
    "timeFinished": {
      "type": "string",
      "format": "date-time",
      "example": "2026-01-15T10:30:00Z"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string"
          },
          "actionType": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "entityUri": {
            "type": "string"
          }
        }
      },
      "example": []
    }
  }
}