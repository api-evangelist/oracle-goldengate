{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ComparisonReport",
  "title": "ComparisonReport",
  "type": "object",
  "properties": {
    "runId": {
      "type": "integer",
      "format": "int64",
      "example": "500123"
    },
    "jobName": {
      "type": "string",
      "example": "example_value"
    },
    "startTime": {
      "type": "string",
      "format": "date-time",
      "example": "2026-01-15T10:30:00Z"
    },
    "endTime": {
      "type": "string",
      "format": "date-time",
      "example": "2026-01-15T10:30:00Z"
    },
    "summary": {
      "type": "object",
      "properties": {
        "totalComparePairs": {
          "type": "integer"
        },
        "inSync": {
          "type": "integer"
        },
        "outOfSync": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        }
      },
      "example": "example_value"
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceTable": {
            "type": "string"
          },
          "targetTable": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "sourceRowCount": {
            "type": "integer",
            "format": "int64"
          },
          "targetRowCount": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "example": []
    }
  }
}