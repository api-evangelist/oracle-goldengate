{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/HeartbeatMetrics",
  "title": "HeartbeatMetrics",
  "type": "object",
  "properties": {
    "processName": {
      "type": "string",
      "example": "example_value"
    },
    "lastHeartbeat": {
      "type": "string",
      "format": "date-time",
      "example": "2026-01-15T10:30:00Z"
    },
    "lagInSeconds": {
      "type": "number",
      "example": 42.5
    }
  }
}